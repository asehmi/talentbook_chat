# Copy this file to .streamlit/secrets.toml for local dev (that file is
# gitignored — never commit real keys). On Streamlit Cloud, set the same
# keys instead under the app's own Settings -> Secrets, in this same TOML
# shape; Streamlit merges them into st.secrets identically either way, so
# nothing in the app needs to change between local dev and a cloud deploy.

# Which LLM provider lib.llm.get_llm_client() uses: anthropic (default),
# gemini, or openrouter. Only the matching key below is required.
LLM_PROVIDER = "anthropic"
ANTHROPIC_API_KEY = ""
GOOGLE_API_KEY = ""
OPENROUTER_API_KEY = ""

# The Talentbook backend this chat connects to over /mcp. Leave unset to
# default to http://localhost:8000. Normally just a pre-filled default for
# the sidebar's "Server address" box — the viewer can always type a
# different address there (e.g. a deployed backend's public URL) — unless
# IS_PROD is true below, in which case this is the only address ever used.
REFLEX_BE_BASE_URL = "http://localhost:8000"

# The Talentbook frontend — where a human signs in and the Connected
# Agents page lives (the Instructions page links here). This is often a
# *different* origin from REFLEX_BE_BASE_URL above (Talentbook's own dev
# setup runs frontend/backend on separate ports) — getting this wrong
# sends an already-signed-in visitor to an origin that was never
# authenticated, so they hit a fresh sign-in challenge. Leave unset to
# default to http://localhost:3000; set both this and REFLEX_BE_BASE_URL
# to the same value if Talentbook is deployed as one process behind one
# public URL.
REFLEX_FE_BASE_URL = "http://localhost:3000"

# True only on the prod deployment, set there (never here) — hides the
# sidebar's "Server address" box and fixes it to REFLEX_BE_BASE_URL above,
# so a viewer's own token can't be used to repoint prod at a different
# backend. Leave unset/false everywhere else (local dev, staging).
IS_PROD = "false"
